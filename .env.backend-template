# Backend Environment Variables Template
# Copy this file to .env on your VPS and fill in all values

# ==========================================
# MONGODB ATLAS
# ==========================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/flow?retryWrites=true&w=majority

# ==========================================
# FIREBASE ADMIN (for server-side auth)
# ==========================================
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# ==========================================
# VERCEL BLOB STORAGE
# ==========================================
# Get your token from: https://vercel.com/dashboard/stores
BLOB_READ_WRITE_TOKEN=your_blob_read_write_token

# ==========================================
# API KEYS
# ==========================================
VITE_GEMINI_API_KEY=your_gemini_key
VITE_MARBLE_API_KEY=your_marble_key
ELEVENLABS_API_KEY=your_elevenlabs_key
ELEVENLABS_VOICE_ID=your_voice_id

# ==========================================
# SERVER
# ==========================================
PORT=3001
