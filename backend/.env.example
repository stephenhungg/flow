# Server
PORT=3001
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/flow

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Vercel Blob (file storage for splats + thumbnails)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxx

# ElevenLabs (text-to-speech for narration)
ELEVENLABS_API_KEY=your_elevenlabs_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Stripe (credit purchases)
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Admin emails (comma-separated, unlimited credits)
ADMIN_EMAILS=admin@example.com

# Gemini (used server-side for orchestration + narration Q&A)
VITE_GEMINI_API_KEY=your_gemini_key

# Marble API (used server-side for image -> 3D proxy)
VITE_MARBLE_API_KEY=your_marble_key
